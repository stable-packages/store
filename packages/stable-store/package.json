{
	"name": "stable-store",
	"version": "1.0.0-beta.2",
	"description": "A single-versioned store to share anything in memory",
	"keywords": [
		"store",
		"module"
	],
	"homepage": "https://github.com/stable-packages/store/tree/main/packages/stable-store",
	"bugs": {
		"url": "https://github.com/stable-packages/store/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stable-packages/store.git",
		"directory": "packages/stable-store"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			}
		}
	},
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,unit,test,accept,integrate,system,pref,stress}.*",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf coverage esm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"w": "pnpm test:watch"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.4.0",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"depcheck": "^1.4.7",
		"rimraf": "^6.1.4",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"type-plus": "8.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
