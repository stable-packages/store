{
	"name": "global-store",
	"version": "1.0.0-beta.24",
	"description": "A library provides version stable stores for libraries.",
	"homepage": "https://github.com/stable-packages/store/tree/main/packages/global-store",
	"bugs": {
		"url": "https://github.com/stable-packages/store/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stable-packages/store.git",
		"directory": "packages/global-store"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"files": [
		"dist",
		"lib",
		"index.js.flow",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf coverage dist lib",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"w": "pnpm test:watch"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.4.0",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"assertron": "^11.7.3",
		"depcheck": "^1.4.7",
		"rimraf": "^6.1.4",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"type-plus": "8.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"size-limit": [
		{
			"path": "./lib/index.js",
			"limit": "2 KB"
		}
	]
}
