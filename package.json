{
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"ea": "pnpm --filter=./examples/astro",
		"el": "pnpm --filter=./examples/library",
		"format": "biome format --write .",
		"gs": "pnpm --filter=global-store",
		"lint": "biome check .",
		"prepare": "husky",
		"release": "changeset publish",
		"size": "turbo run size",
		"ss": "pnpm --filter=stable-store",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "npm-run-all lint verify:turbo",
		"verify:turbo": "turbo run build typecheck coverage depcheck size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@repobuddy/biome": "^2.6.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.4",
		"turbo": "^2.11.11",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.16.1"
}
