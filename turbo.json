{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"ts/**",
				"src/**",
				"!**/*.spec.ts",
				"tsconfig*.json",
				"tsdown.config.ts",
				"rollup.config.mjs",
				"webpack.config.js",
				"astro.config.mjs",
				"package.json"
			],
			"outputs": ["dist/**", "lib/**", "esm/**"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["^build"],
			"inputs": ["ts/**", "vitest.config.ts", "tsconfig*.json", "package.json"],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"dependsOn": ["^build"]
		},
		"size": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": ["ts/**", "src/**", "tsconfig*.json", "package.json"]
		}
	}
}
